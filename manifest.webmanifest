{
  "name": "PFMT — Daily Money Tracker",
  "short_name": "PFMT",
  "description": "Track spending, budgets, bills and transfers across currencies.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#080C16",
  "theme_color": "#080C16",
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Add an expense",
      "short_name": "Expense",
      "url": "./?add=expense",
      "icons": [
        {
          "src": "icons/sc-expense.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Add income",
      "short_name": "Income",
      "url": "./?add=income",
      "icons": [
        {
          "src": "icons/sc-income.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Add a transfer",
      "short_name": "Transfer",
      "url": "./?add=transfer",
      "icons": [
        {
          "src": "icons/sc-transfer.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Update a balance",
      "short_name": "Balance",
      "url": "./?add=balance",
      "icons": [
        {
          "src": "icons/sc-balance.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    }
  ]
}
