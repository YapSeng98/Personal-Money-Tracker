<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.pfmt.weeklybackup</string>

  <key>ProgramArguments</key>
  <array>
    <string>__SCRIPT_PATH__</string>
    <string>--if-due</string>
    <string>__DUE_DAYS__</string>
  </array>

  <!-- A launchd job does NOT inherit your shell environment, so the destination
       has to be handed to it here. Without this, exporting PFMT_BACKUP_DIR in
       .zshrc changed nothing: the installer reported the new folder while every
       scheduled run kept writing to the script's built-in default. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>__ENV_KEY__</key><string>__BACKUP_DIR__</string>
  </dict>

  <!-- Every day at 09:00 the script asks whether a backup is due (7 days
       since the last one for weekly, 28 for monthly) and does nothing if not.
       So a run that fails (no network after waking) is retried the next
       morning instead of a week later. StartCalendarInterval fires on the next
       wake if the Mac was asleep at 09:00. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>9</integer>
    <key>Minute</key><integer>0</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>__LOG_DIR__/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>__LOG_DIR__/launchd.err.log</string>

  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
